DJANGO_SECRET_KEY=degistir-beni
DJANGO_DEBUG=True
# Production'da kendi adresini yaz (örn. kararsizim.vercel.app); joker kullanma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Aynı adresten gelen formlar için gerekmez; boş bırak.
CSRF_TRUSTED_ORIGINS=
# Production'da HSTS süresi (saniye). Varsayılan 3600; sorunsuzsa 31536000.
# DJANGO_HSTS_SECONDS=3600

# Boş bırakılırsa lokal SQLite kullanılır.
# Supabase → Connect → Transaction pooler (port 6543):
DATABASE_URL=
# Supabase → Connect → Session pooler (port 5432), yalnızca migration için:
#   DJANGO_DB_DIRECT=1 python manage.py migrate
DATABASE_URL_DIRECT=
